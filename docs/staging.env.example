# Copy to an ignored .env.staging file or configure these in your secret manager.
# Leave no production values in this template.

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.example.com

# Database
# Use a new, empty PostgreSQL database for the first staging migration.
DATABASE_URL=
DIRECT_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=hirego_staging

# Authentication and internal services — unique, high-entropy values
NEXTAUTH_SECRET=
JWT_SECRET=
SESSION_SECRET=
INTERNAL_API_KEY=
# Dedicated scope: workflow/outbox recovery and its heartbeat endpoint only.
WORKER_RECOVERY_API_KEY=
APP_URL=https://staging.example.com
QSTASH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=

# Security audit forwarding — use an HTTPS receiver in production. The scheduler
# authenticates to the worker with INTERNAL_API_KEY; this token authenticates to SIEM.
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=

# External providers — use sandbox credentials only
OPENAI_API_KEY=
# Required when production AI execution is enabled; amounts are USD per million tokens and INR per USD.
OPENAI_GPT4O_INPUT_USD_PER_MILLION=
OPENAI_GPT4O_OUTPUT_USD_PER_MILLION=
AI_BUDGET_USD_TO_INR=
GEMINI_API_KEY=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_GRAPH_VERSION=v21.0
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
EMAIL_CONFIG_ENCRYPTION_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Generate in Razorpay Dashboard for this webhook endpoint. This is not the API key secret.
RAZORPAY_WEBHOOK_SECRET=
