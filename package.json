{
  "name": "hirego-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx src/tests/suite.test.ts && tsx src/tests/communication-template-regression.test.ts && tsx --test src/tests/security-boundary-regression.test.ts && tsx --test src/tests/skill-validation.test.ts && tsx --test src/tests/knowledge-screening-policy.test.ts && tsx --test src/tests/assessment-policy-validation.test.ts",
    "test:audit": "node scripts/generate-production-wiring-inventory.mjs && node scripts/generate-production-wiring-report.mjs && node scripts/audit-regressions.mjs",
    "test:phase5": "tsx src/tests/run-phase5-tests.ts && tsx --test src/tests/workflow-engine-regression.test.ts && tsx --test src/tests/hiring-pipeline-contract.test.ts",
    "verify:phase5": "prisma validate && prisma generate && tsc --noEmit && eslint src/lib/workflows/WorkflowEngine.ts src/lib/tools/ToolRegistry.ts src/lib/agents/OperationalAgents.ts src/tests/phase5-agent-security.test.ts src/tests/run-phase5-tests.ts src/tests/workflow-engine-regression.test.ts src/tests/hiring-pipeline-contract.test.ts && npm run test:phase5",
    "seed:email-templates": "node scripts/seed-approved-email-templates.mjs",
    "test:attack-matrix": "tsx scripts/authenticated-attack-matrix.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@prisma/client": "^5.22.0",
    "@upstash/redis": "^1.38.2",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "downshift": "^9.4.0",
    "framer-motion": "^12.42.2",
    "html-react-parser": "^6.1.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.26.0",
    "next": "16.3.5",
    "openai": "^4.73.0",
    "pg": "^8.23.0",
    "postcss": "8.5.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-select": "^5.10.2",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "glob": "^13.0.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "minimatch@>=10": "10.2.5",
    "minimatch@<10": "3.1.5"
  }
}
