# Copy this file to an ignored environment file and supply real values through
# your deployment secret manager. Do not commit credentials or API keys.

# Database and infrastructure
DATABASE_URL=
DIRECT_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=hirego_prod
# Upstash Redis (required for distributed rate limits in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional dedicated HMAC key for Redis rate-limit key derivation. If omitted,
# INTERNAL_API_KEY is used. Never store raw WhatsApp sender IDs in Redis keys.
RATE_LIMIT_HMAC_SECRET=\n# Dedicated HMAC key for one-time verification codes at rest.\nOTP_HMAC_SECRET=

# Authentication and internal services (use unique, high-entropy values)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://hiregoai.com
JWT_SECRET=
SESSION_SECRET=
INTERNAL_API_KEY=
# Set true only after the immutable release checklist and provider/staging
# evidence have been approved. This flag does not perform validation itself.
RELEASE_SIGNED_OFF=false
# Vercel sends this automatically. Set TRUST_PROXY_HEADERS only on another
# trusted reverse proxy that overwrites (rather than forwards) client headers.
TRUST_PROXY_HEADERS=false

# AI providers (server-side only). Model IDs, prices and task routing live in
# Admin -> AI Model Registry / Control Centre, not in production business code.
# One-time deployment secret for AES-256-GCM-encrypted Admin LLM keys (32 bytes; base64 or 64 hex).
# Generate securely (for example with openssl rand -base64 32). Never rotate without
# migrating/re-encrypting every persisted credential first.
AI_PROVIDER_CREDENTIALS_ENCRYPTION_KEY=
# Only these public HTTPS hosts may be configured for self-hosted LLMs from Admin.
AI_SELF_HOSTED_ALLOWED_HOSTS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
# Optional override; when omitted the server uses Google's OpenAI-compatible endpoint.
GEMINI_BASE_URL=
DEEPSEEK_API_KEY=
# Optional override; when omitted the official DeepSeek API endpoint is used.
DEEPSEEK_BASE_URL=
KIMI_API_KEY=
# Optional override; when omitted the official Kimi/Moonshot OpenAI-compatible endpoint is used.
KIMI_BASE_URL=
QWEN_API_KEY=
# Required for Qwen because Model Studio endpoints are workspace/region specific.
QWEN_BASE_URL=
# Private/self-hosted OpenAI-compatible LLM endpoint. Both URL and server-only
# authentication key are required before the provider can be enabled.
SELF_HOSTED_LLM_BASE_URL=
SELF_HOSTED_LLM_API_KEY=

# HireGo-owned self-hosted Voice Engine. Candidate Jarvis voice stays fail-closed
# until the authenticated worker has passed its internal TTS -> STT E2E self-test.
HIREGO_VOICE_ENGINE_URL=
HIREGO_VOICE_ENGINE_TOKEN=
# Set true only after authenticated mic -> STT -> Jarvis -> TTS -> playback verification.
HIREGO_VOICE_ENGINE_E2E_VERIFIED=false
HIREGO_VOICE_STT_MODEL=Systran/faster-whisper-base
HIREGO_VOICE_TTS_MODEL=speaches-ai/piper-en_US-hfc_female-medium
# Required in production for converting model USD token cost into INR minor units
# used by HireGo AI budget reservations/reconciliation.
AI_BUDGET_USD_TO_INR=

# Object storage (Cloudflare R2 / AWS S3 compatible)
# S3_SECRET_ACCESS_KEY and S3_ACCESS_KEY_ID are sensitive secrets.
# S3_BUCKET_NAME, S3_REGION, and S3_ENDPOINT are server-only.
# Never expose any S3_* variables to the browser or client-side bundles.
S3_BUCKET_NAME=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
# Required in production. Uploads remain quarantined when scanning is
# unavailable. The URL must be credential-free HTTPS.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# WhatsApp Business
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_GRAPH_VERSION=

# Durable background dispatch for WhatsApp processing
QSTASH_TOKEN=
# Canonical public origin used by Railway recovery and QStash callbacks.
APP_URL=https://hiregoai.com
# Required dedicated shared secret between Railway and the full recovery endpoint (32+ chars).
# The full recovery worker does not accept CRON_SECRET as a fallback.
WORKER_RECOVERY_API_KEY=
# Separate high-entropy secret used only by the cron routes that explicitly require CRON_SECRET.
CRON_SECRET=
# Optional Vercel Deployment Protection bypass used by external automation such as Railway.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Safe rollout control for the Railway background scheduler. Keep false until
# DATABASE_URL/DIRECT_URL, storage, callback, and video-worker secrets have
# been mirrored into Railway. When true, the scheduler processes the durable
# queues directly instead of invoking the app cron endpoints over HTTPS.
RAILWAY_DIRECT_BACKGROUND_WORKER=false
# Railway may use plain HTTP only for an explicitly private local service name.
ALLOW_INTERNAL_HTTP=0

# Security-audit outbox delivery (server-only SIEM receiver)
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=

# Realtime interviews / TURN
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Transactional email (used for website, mobile-app, and WhatsApp OTP verification)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Preferred Zoho CPaaS settings. Use the Agent-specific Send Mail Token from
# Agents -> SMTP/API. For the India data center, the console shows cpaas.zoho.in.
ZOHO_CPAAS_SEND_MAIL_TOKEN=
ZOHO_CPAAS_FROM_EMAIL=
ZOHO_CPAAS_API_BASE_URL=https://cpaas.zoho.in/v1.1
# Legacy names remain supported temporarily so an existing ZeptoMail deployment
# can migrate without a flag day. Prefer the ZOHO_CPAAS_* variables above.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
# Required only when API keys are saved from the admin panel. Generate a unique
# 32-byte base64 value (or use a 64-character hex key); never rotate it without
# first rotating/re-entering the stored provider keys.
EMAIL_CONFIG_ENCRYPTION_KEY=
# Required in production to hash recipient addresses and derive the
# short-lived encrypted communication-retry envelope key. Use a unique
# high-entropy server-side secret of at least 32 characters.
COMMUNICATION_HASH_SECRET=
# Comma-separated recipients permitted for admin test sends in production.
COMMUNICATION_TEST_RECIPIENT_ALLOWLIST=

# Payment providers (Approved production architecture: STRIPE + PAYU)
# Stripe server-side secrets (never expose to browser / client-side)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayU server-side merchant credentials
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Use production for live PayU endpoints; use test only in isolated staging.
PAYU_ENVIRONMENT=production

# Optional generic fallback payment webhook secret
PAYMENT_WEBHOOK_SECRET=

# Public discovery / indexing (server-side only)
# IndexNow key is not a secret, but keep one stable value and expose it only
# through /indexnow-key.txt. Participating engines share accepted submissions.
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=https://www.hiregoai.com/indexnow-key.txt
# Optional. JSON for a Google service account that has Search Console ownership
# and Indexing API access. Used only for eligible JobPosting URLs.
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# Public application URL
NEXT_PUBLIC_APP_URL=https://hiregoai.com

# Video Analysis System (privacy-first worker; Whisper transcription)
VIDEO_ANALYSIS_ENABLED=false
VIDEO_ANALYSIS_WORKER_URL=http://localhost:8000
VIDEO_ANALYSIS_INTERNAL_TOKEN=
# Public HTTPS application origin used in worker callback URLs. When omitted,
# NEXT_PUBLIC_APP_URL is used.
VIDEO_ANALYSIS_CALLBACK_ORIGIN=https://hiregoai.com
VIDEO_ANALYSIS_MAX_SECONDS=120
VIDEO_ANALYSIS_TIMEOUT_SECONDS=600
VIDEO_ANALYSIS_RETENTION_DAYS=30

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=.model_cache
