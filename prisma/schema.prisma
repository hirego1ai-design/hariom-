generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
  RECRUITER
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  AI_INTERVIEW
  ASSESSMENT
  SHORTLISTED
  HIRED
  REJECTED
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum CustomSkillStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  sessionVersion Int      @default(0)
  name          String
  role          Role     @default(CANDIDATE)
  phoneNumber   String?
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidateProfile   CandidateProfile?
  employerProfile    EmployerProfile?
  auditLogs          AuditLog[]
  notifications      Notification[]
  aiUsages           AiUsage[]
  proctoringEvents   ProctoringTelemetry[]
  storedFiles        StoredFile[]
  savedJobs          SavedJob[]
  referralsInitiated ReferralAttribution[] @relation("UserReferrer")
  referralReceived   ReferralAttribution?  @relation("UserReferred")
  referralPayouts       ReferralPayout[]
  referralRewards       ReferralReward[]      @relation("UserReferralRewards")
  referralLedgerEntries ReferralLedgerEntry[]
  customSkillRequests   CustomSkillRequest[]
  whatsAppContact       WhatsAppContact?

  @@index([phoneNumber])
}

model CandidateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String?
  location        String?
  skills          String[] @default([])
  education       Json?
  experience      Json?
  preferences     Json?
  experienceYears Float    @default(0)
  hireGoScore     Int      @default(0)
  resumeUrl       String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videoResumes VideoResume[]
  applications Application[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  website     String?
  description String?
  industry    String?
  size        String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employers        EmployerProfile[]
  jobs             JobListing[]
  subscriptions    CompanySubscription[]
  credits          CompanyCredits?
  referralReceived ReferralAttribution?  @relation("CompanyReferred")
  hiringRequirements HiringRequirement[]
  commercialAgreements CommercialAgreement[]
  storedFiles      StoredFile[]
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  designation String?
  documents   DocumentVerification[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobListing {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  department   String?
  location     String
  type         String    @default("Full-time")
  salaryRange  String?
  description  String
  requirements String[]  @default([])
  status       JobStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications Application[]
  savedBy      SavedJob[]
}

// Shared role-to-skill catalog used by candidate profiles, job creation,
// matching, skill-gap analysis, interviews, and course recommendations.
model SkillMaster {
  id          String             @id @default(uuid())
  name        String             @unique
  slug        String             @unique
  category    String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  roleMappings RoleSkillMapping[]
}

model RoleSkillMapping {
  id                     String      @id @default(uuid())
  roleTitle              String
  industry               String?
  department             String?
  skillId                String
  skill                  SkillMaster @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillCategory          String
  priority               String      @default("preferred")
  recommendedProficiency String      @default("intermediate")
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([roleTitle, skillId])
  @@index([roleTitle, industry, department])
}

model CustomSkillRequest {
  id               String            @id @default(uuid())
  name             String
  normalizedName   String
  suggestedForRole String?
  requestedById    String
  requestedBy      User              @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status           CustomSkillStatus @default(PENDING)
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([normalizedName])
}

model SavedJob {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, jobId])
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String   @default("VERIFY_EMAIL")
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Application {
  id                 String            @id @default(uuid())
  jobId              String
  job                JobListing        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  status             ApplicationStatus @default(APPLIED)
  matchScore         Int               @default(0)
  aiSummary          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  interviews Interview[]
}

model VideoResume {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  videoUrl           String
  durationSeconds    Int
  transcript         String?
  communicationScore Int              @default(0)
  confidenceScore    Int              @default(0)
  clarityScore       Int              @default(0)
  professionalism    Int              @default(0)
  createdAt          DateTime         @default(now())
}

model Interview {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  durationMins  Int         @default(30)
  status        String      @default("SCHEDULED")
  roomUrl       String?
  transcript    String?
  aiFeedback    String?
  proctoringEvents ProctoringTelemetry[]
  signals          InterviewSignal[]
  createdAt     DateTime    @default(now())
}

// Short-lived, database-backed WebRTC signaling. This deliberately replaces
// process-local Maps so replicas see the same room state. Payloads expire and
// are never used as a recording or permanent chat store.
model InterviewSignal {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  senderId    String
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([interviewId, createdAt])
  @@index([expiresAt])
}

model ProctoringTelemetry {
  id            String    @id @default(uuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  violationType String
  severity      String
  createdAt     DateTime  @default(now())

  @@index([interviewId, createdAt])
  @@index([candidateId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
}

model StoredFile {
  id           String    @id @default(uuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  objectKey    String    @unique
  category     String
  originalName String
  mimeType     String
  sizeBytes    Int
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([ownerId, createdAt])
  @@index([companyId, createdAt])
}

model AiUsage {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentType     String
  tokensUsed    Int      @default(0)
  estimatedCost Float    @default(0.0)
  createdAt     DateTime @default(now())
}

enum RequirementStatus {
  SUBMITTED
  IN_DISCUSSION
  AGREEMENT_DRAFTED
  AGREEMENT_SENT
  ACTIVE
  CLOSED
}

enum AgreementStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT_TO_EMPLOYER
  AMENDMENT_REQUESTED
  ACTIVE
  REJECTED
  EXPIRED
}

model HiringRequirement {
  id                     String            @id @default(uuid())
  referenceCode          String            @unique
  companyId              String?
  company                Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyName            String
  contactPerson          String
  email                  String
  primaryMobile          String
  secondaryMobile        String?
  industry               String
  numberOfPositions      Int
  jobTitles              String[]          @default([])
  experienceYears        String
  skillsRequired         String[]          @default([])
  education              String
  certifications         String?
  salaryRangeMin         Float
  salaryRangeMax         Float
  currency               String            @default("INR")
  workMode               String            @default("Hybrid")
  location               String
  joiningTimeline        String
  hiringPriority         String            @default("Standard")
  replacementExpectation String            @default("90 Days")
  additionalNotes        String?
  jdFileUrl              String?
  status                 RequirementStatus @default(SUBMITTED)
  assignedSalesLead      String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  agreements CommercialAgreement[]

  @@index([companyId])
}

model AgreementTemplate {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  description         String
  category            String   @default("General") // Startup, Growth, Enterprise, Executive, Campus, Custom
  feeType             String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  feeValue            Float    @default(8.33)
  invoiceRule         String   @default("ON_JOINING") // ON_OFFER, ON_JOINING, DAY_30, SPLIT_50_50
  replacementDays     Int      @default(90)
  validityMonths      Int      @default(12)
  advancePayment      Float    @default(0.0)
  creditTermsDays     Int      @default(15)
  standardDiscountPct Float    @default(0.0)
  taxRatePct          Float    @default(18.0)
  specialClauses      String[] @default([])
  commercialNotes     String?
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CommercialAgreement {
  id              String             @id @default(uuid())
  agreementNumber String             @unique
  companyId       String?
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requirementId   String?
  requirement     HiringRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  templateId      String?
  companyName     String
  clientLegalName String
  contactPerson   String
  clientEmail     String
  clientPhone     String
  status          AgreementStatus    @default(DRAFT)

  // Commercial Parameters
  feeType              String   @default("PERCENTAGE")
  feeValue             Float    @default(8.33)
  invoiceRule          String   @default("ON_JOINING")
  replacementDays      Int      @default(90)
  validityStartDate    DateTime @default(now())
  validityEndDate      DateTime
  advancePaymentAmount Float    @default(0.0)
  discountPercentage   Float    @default(0.0)
  creditDays           Int      @default(15)
  taxRatePct           Float    @default(18.0)

  // Custom Legal Terms & Clauses
  customClauses       String[] @default([])
  commercialNotes     String?
  salesExecutiveNotes String?

  // Signing & Acceptance Metadata
  signedByName        String?
  signedByDesignation String?
  signedAt            DateTime?
  signerIpAddress     String?
  amendmentNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AgreementEvent[]

  @@index([companyId])
}

model AgreementEvent {
  id          String              @id @default(uuid())
  agreementId String
  agreement   CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  eventType   String // CREATED, DRAFT_UPDATED, SENT, AMENDMENT_REQUESTED, ACCEPTED, REJECTED
  performedBy String
  notes       String?
  createdAt   DateTime            @default(now())
}

enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  agreementId   String
  companyName   String
  candidateName String?
  jobTitle      String?
  amount        Float
  taxAmount     Float
  totalAmount   Float
  currency      String        @default("INR")
  status        PaymentStatus @default(UNPAID)
  dueDate       String
  paidDate      String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PaymentTransaction {
  id           String   @id @default(uuid())
  gatewayTxId  String   @unique
  companyId    String
  planId       String?
  amount       Float    @default(0.0)
  currency     String   @default("INR")
  status       String   @default("PENDING") // PENDING | SUCCESS | FAILED | REJECTED
  provider     String   @default("RAZORPAY") // RAZORPAY | STRIPE
  rawPayload   Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model IdempotencyRecord {
  id              String   @id @default(uuid())
  companyId       String
  idempotencyKey  String
  requestHash     String
  status          String   @default("PROCESSING") // PROCESSING | SUCCESS | FAILED
  jobId           String?
  responsePayload Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
}

model PaymentGatewayConfig {
  id                     String   @id @default("global-gateway-config")
  mode                   String   @default("AUTO") // AUTO | MANUAL
  primaryGateway         String   @default("RAZORPAY") // RAZORPAY | PAYU | PHONEPE
  autoFailover           Boolean  @default(true)
  allowEmployerSelection Boolean  @default(true)
  gatewaysStatus         Json     // { RAZORPAY: "HEALTHY", PAYU: "HEALTHY", PHONEPE: "HEALTHY" }
  priorities             Json     // ["RAZORPAY", "PAYU", "PHONEPE"]
  updatedAt              DateTime @updatedAt
}

// Global transactional-email delivery policy. API credentials are encrypted
// before storage and are never returned by the admin API.
model EmailDeliveryConfig {
  id                        String   @id @default("global-email-delivery")
  primaryProvider           String   @default("SENDGRID")
  fallbackProvider          String   @default("ZEPTOMAIL")
  autoFailover              Boolean  @default(true)
  sendgridEnabled           Boolean  @default(true)
  zeptoMailEnabled          Boolean  @default(false)
  sendgridFromEmail         String?
  zeptoMailFromEmail        String?
  sendgridApiKeyEncrypted   String?
  zeptoMailApiKeyEncrypted  String?
  updatedAt                 DateTime @updatedAt
}

model AiExecutionLog {
  id               String   @id @default(uuid())
  task             String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  latencyMs        Int
  costEstUsd       Float
  status           String
  timestamp        DateTime @default(now())
}

model SubscriptionPlan {
  id                           String   @id @default(uuid())
  name                         String
  description                  String
  price                        Float
  currency                     String   @default("INR")
  jobPostsQuota                Int
  resumeUnlocksQuota           Int
  aiInterviewsQuota            Int
  applicationsQuota            Int      @default(100)
  resumeDownloadsQuota         Int      @default(50)
  backgroundVerificationsQuota Int      @default(5)
  featuresAllowed              String[] @default([])
  validityMonths               Int      @default(1)
  isArchived                   Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  subscriptions CompanySubscription[]
}

model CompanySubscription {
  id        String           @id @default(uuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  startDate DateTime         @default(now())
  endDate   DateTime
  status    String           @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  paymentId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model CompanyCredits {
  id                          String   @id @default(uuid())
  companyId                   String   @unique
  company                     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPostsLeft                Int      @default(0)
  resumeUnlocksLeft           Int      @default(0)
  aiInterviewsLeft            Int      @default(0)
  applicationsLeft            Int      @default(0)
  resumeDownloadsLeft         Int      @default(0)
  backgroundVerificationsLeft Int      @default(0)
  updatedAt                   DateTime @updatedAt
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String // PERCENTAGE | FLAT
  discountValue Float
  maxUsage      Int       @default(9999)
  usageCount    Int       @default(0)
  validUntil    DateTime?
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AiServiceCost {
  id          String   @id @default(uuid())
  serviceKey  String   @unique // e.g. "resume_screening"
  serviceName String
  creditCost  Int
  billingType String // INCLUDED | CREDIT_BASED | PAID_ADDON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================================================================
// HireGo AI ROS — Recruitment Operating System Models
// 16 models. Single migration: init_ros_architecture
// These models integrate WITH the existing HireGo business schema.
// They do NOT replace User, Company, JobListing, Application, etc.
// ================================================================

// ================================================================
// MODEL 1: SYSTEM EVENT (IMMUTABLE EVENT HISTORY)
// ================================================================
// What actually happened. Immutable after creation.
// Created by EventDispatcher via idempotent upsert.
// ================================================================

enum EventScope {
  GLOBAL
  TENANT
}

model SystemEvent {
  id             String     @id @default(uuid())
  scope          EventScope @default(TENANT)
  companyId      String? // Null for global events
  eventType      String
  eventVersion   Int        @default(1)
  actorId        String?
  correlationId  String
  idempotencyKey String     @unique
  payload        Json
  createdAt      DateTime   @default(now())

  @@index([scope, companyId])
  @@index([eventType])
  @@index([correlationId])
}

// ================================================================
// MODEL 2: TRANSACTIONAL OUTBOX (DELIVERY MECHANISM)
// ================================================================
// Written in same DB transaction as business state change.
// Polled by OutboxPoller using FOR UPDATE SKIP LOCKED.
// Status: PENDING → PROCESSING → DISPATCHED | FAILED
// ================================================================

model OutboxEntry {
  id             String    @id @default(uuid())
  eventType      String
  payload        Json
  correlationId  String
  companyId      String?
  idempotencyKey String    @unique
  status         String    @default("PENDING")
  retryCount     Int       @default(0)
  maxRetries     Int       @default(5)
  createdAt      DateTime  @default(now())
  claimedAt      DateTime?
  dispatchedAt   DateTime?
  failedAt       DateTime?

  @@index([status, createdAt])
}

// ================================================================
// MODEL 3: EVENT CONSUMER CHECKPOINT (CONSUMER PROCESSING STATE)
// ================================================================
// Tracks which consumers have processed which events.
// Composite unique: one event may be processed by multiple consumers.
// This is a record of completion, NOT a distributed lock.
// Consumer handlers must be independently idempotent.
// ================================================================

model EventConsumerCheckpoint {
  id             String   @id @default(uuid())
  idempotencyKey String
  consumerId     String
  status         String   @default("PROCESSED")
  processedAt    DateTime @default(now())

  @@unique([idempotencyKey, consumerId])
}

// ================================================================
// MODEL 4: WORKFLOW INSTANCE
// ================================================================

enum WorkflowStatus {
  PENDING
  RUNNING
  PAUSED_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowInstance {
  id              String         @id @default(uuid())
  companyId       String?
  jobId           String?
  candidateId     String?
  applicationId   String?
  interviewId     String?
  workflowType    String
  workflowVersion String         @default("1.0.0")
  status          WorkflowStatus @default(PENDING)
  currentStep     String
  checkpointState Json
  correlationId   String         @unique
  initiatedBy     String
  failureCount    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  steps WorkflowStepLog[]
}

// ================================================================
// MODEL 5: WORKFLOW STEP LOG (REAL IDEMPOTENCY KEY)
// ================================================================
// executionKey = deterministic: "{workflowId}:{stepName}:{attemptNumber}"
// sideEffectDone guards against re-execution on crash recovery.
// External side effects must additionally use their own business
// idempotency keys (see IdempotencyGuard).
// ================================================================

model WorkflowStepLog {
  id                 String           @id @default(uuid())
  workflowInstanceId String
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stepName           String
  executionKey       String           @unique
  attemptNumber      Int              @default(1)
  status             String
  sideEffectDone     Boolean          @default(false)
  inputPayload       Json?
  outputPayload      Json?
  errorMessage       String?
  durationMs         Int              @default(0)
  createdAt          DateTime         @default(now())

  @@index([workflowInstanceId, stepName])
}

// ================================================================
// MODEL 6: AGENT MEMORY RECORD (3 AGENT LAYERS ONLY)
// ================================================================
// BUSINESS_STATE is NOT stored here. It lives in PostgreSQL
// business tables and is accessed exclusively through Tools.
// ================================================================

enum MemoryType {
  WORKING
  DOMAIN
  KNOWLEDGE
}

enum MemoryScopeLevel {
  COMPANY
  JOB
  CANDIDATE
  APPLICATION
  INTERVIEW
  WORKFLOW
}

model AgentMemoryRecord {
  id           String           @id @default(uuid())
  memoryType   MemoryType       @default(DOMAIN)
  scopeLevel   MemoryScopeLevel @default(COMPANY)
  scopeId      String
  companyId    String?
  agentId      String
  key          String
  value        Json
  ttlSeconds   Int?
  expiresAt    DateTime?
  isAnonymized Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([scopeLevel, scopeId, agentId, key])
  @@index([companyId, scopeLevel, scopeId])
}

// ================================================================
// MODEL 7: AI COMPANY BUDGET
// ================================================================

model AiCompanyBudget {
  id                         String   @id @default(uuid())
  companyId                  String   @unique
  currency                   String   @default("INR")
  monthlyLimitMinorUnits     BigInt   @default(5000000)
  costPerCandidateLimitMinor BigInt   @default(50000)
  costPerInterviewLimitMinor BigInt   @default(20000)
  currentSpendMinorUnits     BigInt   @default(0)
  reservedSpendMinorUnits    BigInt   @default(0)
  isHardCapEnabled           Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
}

// ================================================================
// MODEL 8: BUDGET RESERVATION (KEYED BY EXECUTION ID)
// ================================================================
// Currency inherited from AiCompanyBudget. Not stored here.
// executionId = one agent task execution (not correlationId,
// because one workflow may spawn multiple billable executions).
// ================================================================

model BudgetReservation {
  id            String    @id @default(uuid())
  companyId     String
  executionId   String    @unique
  correlationId String
  reservedMinor BigInt
  actualMinor   BigInt?
  status        String    @default("HELD")
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
