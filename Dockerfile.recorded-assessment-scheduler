FROM node:20-alpine

WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache libc6-compat openssl

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --include=dev && npx prisma generate

COPY tsconfig.json ./tsconfig.json
COPY src ./src
COPY scripts/run-recorded-assessment-scheduler.mjs ./scripts/run-recorded-assessment-scheduler.mjs

USER node

CMD ["./node_modules/.bin/tsx", "scripts/run-recorded-assessment-scheduler.mjs"]
